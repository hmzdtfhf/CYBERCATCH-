PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
AWS_REGION=ap-south-1
# Use demo unless backend has an IAM role or AWS credential chain and explicit IDs.
AWS_DEMO_MODE=true
LAB_INSTANCE_IDS=i-0123456789abcdef0
# Replace with a high-entropy secret before production. Demo token works only in demo mode.
ADMIN_API_TOKEN=replace-with-high-entropy-token
