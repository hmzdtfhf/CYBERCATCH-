resource "aws_security_group" "dvwa" { name="isolated-dvwa-lab" description="No public DVWA" vpc_id=var.vpc_id ingress { from_port=443 to_port=443 protocol="tcp" cidr_blocks=[var.admin_cidr] } dynamic "ingress" { for_each=var.enable_ssh ? [1] : [] content { from_port=22 to_port=22 protocol="tcp" cidr_blocks=[var.admin_cidr] } } egress { from_port=443 to_port=443 protocol="tcp" cidr_blocks=["0.0.0.0/0"] } }
